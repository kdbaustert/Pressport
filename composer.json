{
	"name": "kdbaustert/migrateplus",
	"description": "Move content between WordPress sites as JSON.",
	"type": "wordpress-plugin",
	"license": "GPL-3.0-or-later",
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"composer/installers": "^2.3",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"php-parallel-lint/php-parallel-lint": "^1.4",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpunit/phpunit": "^9.6",
		"roots/wordpress-no-content": "^6.8",
		"squizlabs/php_codesniffer": "^3.13",
		"wp-coding-standards/wpcs": "^3.1",
		"wp-phpunit/wp-phpunit": "^6.8",
		"wpackagist-plugin/advanced-custom-fields": "^6.3",
		"wpackagist-plugin/woocommerce": "~11.0.1",
		"yoast/phpunit-polyfills": "^4.0"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"composer/installers": true
		},
		"platform": {
			"php": "7.4.33"
		},
		"sort-packages": true
	},
	"scripts": {
		"lint": "parallel-lint --exclude vendor --exclude .git .",
		"phpcs": "phpcs",
		"phpcbf": "phpcbf",
		"test": "phpunit"
	},
	"repositories": [
		{
			"name": "wpackagist",
			"type": "composer",
			"url": "https://wpackagist.org",
			"only": [
				"wpackagist-plugin/*"
			]
		}
	],
	"extra": {
		"installer-paths": {
			"vendor/wpackagist-plugin/{$name}/": [
				"type:wordpress-plugin"
			]
		}
	}
}
